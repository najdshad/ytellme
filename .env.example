# Copy to .env and fill in. Only OPENAI_API_KEY is mandatory.

# --- LLM agents (researcher / editor / scriptwriter) --------------------------
# Any OpenAI-compatible /chat/completions endpoint.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.7
OPENAI_TIMEOUT_S=180
LLM_MAX_RETRIES=3

# --- Script shaping -----------------------------------------------------------
# Advisory only. The scriptwriter uses it to pick a segment count; audio is the
# real clock.
TARGET_DURATION_S=90

# --- Voice (local piper) ------------------------------------------------------
# Voice ids resolve to en/en_US/ryan/medium/en_US-ryan-medium.onnx on HuggingFace.
# First run downloads it into models/piper/.
PIPER_VOICE=en_US-ryan-medium
# >1 is slower speech, <1 is faster.
PIPER_LENGTH_SCALE=1.0
PIPER_DIR=models/piper

# --- Images (ComfyUI over HTTP) -----------------------------------------------
# "auto" probes, in order: this value if concrete, 127.0.0.1, the WSL2 default
# gateway, and the resolver nameserver. ComfyUI on a separate Windows box needs
# `--listen 0.0.0.0` plus a firewall rule.
COMFY_BASE_URL=auto
# An "Export (API)" workflow from the ComfyUI UI, with {{TOKEN}} placeholders.
COMFY_WORKFLOW=workflows/stickfigure.json
# Optional: name of the checkpoint in that workflow. Empty = whatever it has.
COMFY_CHECKPOINT=
COMFY_WIDTH=768
COMFY_HEIGHT=432
COMFY_STEPS=22
COMFY_CFG=6.0
COMFY_BASE_SEED=1234
COMFY_TIMEOUT_S=180

# --- Assembly -----------------------------------------------------------------
# Silence appended after each segment's audio, so video and audio cannot drift.
SEGMENT_PADDING_S=0.25
FPS=30
CRF=20
FADE_S=0.3
# auto = burn on_screen_text when present, else the narration
# on_screen_text = only burn on_screen_text   off = no captions
CAPTION_MODE=auto

# --- Retries ------------------------------------------------------------------
MEDIA_MAX_RETRIES=3